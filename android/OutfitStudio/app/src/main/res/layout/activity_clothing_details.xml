<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivClothingDetail"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:scaleType="centerCrop"
            android:background="@color/secondary_variant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_bottom_sheet"
            android:layout_marginTop="-24dp"
            android:elevation="4dp">



            <TextView
                android:id="@+id/tvDetailCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textColor="@color/primary_variant"
                android:textSize="18sp"
                android:layout_marginBottom="4dp"/>
                
            <TextView
                android:id="@+id/tvDetailColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Color"
                android:textColor="@color/text_hint"
                android:textSize="16sp"
                android:layout_marginBottom="32dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="USAGE"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>
                
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/rounded_card_bg"
                    android:layout_marginEnd="8dp">
                    
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Worn"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp"/>
                        
                    <TextView
                        android:id="@+id/tvWornCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0 times"
                        android:textColor="@color/on_background"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/rounded_card_bg"
                    android:layout_marginStart="8dp">
                    
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Last Worn"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp"/>
                        
                    <TextView
                        android:id="@+id/tvLastWorn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Never"
                        android:textColor="@color/on_background"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                
            </LinearLayout>
            
            <TextView
                android:id="@+id/tvRarelyUsedWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RARELY USED\nNot worn for over 4 months"
                android:textColor="@color/error"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"
                android:visibility="gone"/>

                
            <Button
                android:id="@+id/btnDonate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Donate This Item"
                android:layout_marginBottom="16dp"
                app:cornerRadius="12dp"
                android:backgroundTint="@color/error"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.Button"/>

            <Button
                android:id="@+id/btnCompleteLook"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Complete the Look"
                android:layout_marginBottom="16dp"
                app:cornerRadius="12dp"
                style="@style/Widget.MaterialComponents.Button"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <Button
                    android:id="@+id/btnEdit"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Edit"
                    android:textColor="@color/primary"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@color/primary"
                    android:layout_marginEnd="8dp"/>
                    
                <Button
                    android:id="@+id/btnDelete"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Delete"
                    android:textColor="@color/error"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@color/error"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginTop="16dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
