<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Score: 95"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primary"/>

        <TextView
            android:id="@+id/tvReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Excellent color harmony."
            android:textSize="14sp"
            android:textColor="@color/text_hint"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- Top -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                
                <ImageView
                    android:id="@+id/ivTop"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:scaleType="centerCrop"
                    android:background="#EEEEEE"/>
                <TextView
                    android:id="@+id/tvTopName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Top"
                    android:textSize="12sp"
                    android:lines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Bottom -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                
                <ImageView
                    android:id="@+id/ivBottom"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:scaleType="centerCrop"
                    android:background="#EEEEEE"/>
                <TextView
                    android:id="@+id/tvBottomName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bottom"
                    android:textSize="12sp"
                    android:lines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Footwear -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                
                <ImageView
                    android:id="@+id/ivFootwear"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:scaleType="centerCrop"
                    android:background="#EEEEEE"/>
                <TextView
                    android:id="@+id/tvFootwearName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Footwear"
                    android:textSize="12sp"
                    android:lines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRateOutfit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="ANALYZE THIS OUTFIT"
            app:cornerRadius="8dp"
            android:backgroundTint="@color/primary"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
