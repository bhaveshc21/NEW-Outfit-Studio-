<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="32dp">

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to Outfit Studio"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/on_background"
        android:textAlignment="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnProfile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
        
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your AI Personal Stylist"
        android:textSize="18sp"
        android:textColor="@color/primary_variant"
        app:layout_constraintTop_toBottomOf="@id/tvWelcome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go to Profile"
        android:textColor="@color/on_primary"
        android:background="@drawable/bg_button_rounded"
        app:backgroundTint="@null"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintBottom_toTopOf="@id/btnWardrobe"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginTop="64dp"/>

    <Button
        android:id="@+id/btnWardrobe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Wardrobe"
        android:textColor="@color/primary"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:strokeColor="@color/primary"
        app:layout_constraintTop_toBottomOf="@id/btnProfile"
        app:layout_constraintBottom_toTopOf="@id/btnGenerateOutfit"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btnGenerateOutfit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Generate Outfit"
        android:textColor="@color/on_primary"
        android:background="@drawable/bg_button_rounded"
        app:backgroundTint="@null"
        app:layout_constraintTop_toBottomOf="@id/btnWardrobe"
        app:layout_constraintBottom_toTopOf="@id/btnSmartShopping"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btnSmartShopping"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Smart Shopping Assistant"
        android:textColor="@color/primary"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:strokeColor="@color/primary"
        app:layout_constraintTop_toBottomOf="@id/btnGenerateOutfit"
        app:layout_constraintBottom_toTopOf="@id/btnClosetStatistics"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btnClosetStatistics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Closet Statistics"
        android:textColor="@color/on_primary"
        android:background="@drawable/bg_button_rounded"
        app:backgroundTint="@null"
        app:layout_constraintTop_toBottomOf="@id/btnSmartShopping"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
