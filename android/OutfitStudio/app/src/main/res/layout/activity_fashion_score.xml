<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RATE MY OUTFIT"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/on_background"
                android:textAlignment="center"
                android:fontFamily="serif"
                android:layout_marginBottom="16dp"/>

            <!-- Loading State -->
            <LinearLayout
                android:id="@+id/llLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginTop="50dp">
                
                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/primary"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Analyzing your outfit..."
                    android:layout_marginTop="16dp"/>
            </LinearLayout>

            <!-- Content Area -->
            <LinearLayout
                android:id="@+id/llContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Current Outfit -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Outfit"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"/>
                
                <include layout="@layout/item_outfit_card" android:id="@+id/incCurrentOutfit" />

                <!-- Score Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="2dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fashion Score"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary"/>
                            
                        <TextView
                            android:id="@+id/tvOverallScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="86 / 100"
                            android:textSize="40sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_background"/>
                            
                        <TextView
                            android:id="@+id/tvOverallRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Very Good"
                            android:textSize="18sp"
                            android:textColor="@color/primary"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Factor Evaluations -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Evaluation Breakdown"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"/>
                    
                <LinearLayout
                    android:id="@+id/llFactors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_card_bg"
                    android:padding="16dp">
                    <!-- Dynamic factors will be added here -->
                </LinearLayout>

                <!-- Suggestions -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Improvement Suggestions"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>
                    
                <LinearLayout
                    android:id="@+id/llSuggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_card_bg"
                    android:padding="16dp">
                    <!-- Dynamic suggestions will be added here -->
                </LinearLayout>

                <!-- Improved Outfit -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Improved Outfit"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>
                    
                <include layout="@layout/item_outfit_card" android:id="@+id/incImprovedOutfit" />
                
                <TextView
                    android:id="@+id/tvNoImprovedOutfit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your current wardrobe does not contain a better combination right now."
                    android:textColor="@color/text_hint"
                    android:textAlignment="center"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
