<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="32dp">

    <TextView
        android:id="@+id/tvChangePasswordTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Change Password"
        android:textSize="24sp"
        android:textColor="@color/on_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp"/>

    <EditText
        android:id="@+id/etOldPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Old Password"
        android:inputType="textPassword"
        android:background="@drawable/bg_edit_text"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/text_hint"
        app:layout_constraintTop_toBottomOf="@id/tvChangePasswordTitle"
        android:layout_marginTop="32dp"/>

    <EditText
        android:id="@+id/etNewPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="New Password (min 6 chars)"
        android:inputType="textPassword"
        android:background="@drawable/bg_edit_text"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/text_hint"
        app:layout_constraintTop_toBottomOf="@id/etOldPassword"
        android:layout_marginTop="16dp"/>

    <EditText
        android:id="@+id/etConfirmPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Confirm New Password"
        android:inputType="textPassword"
        android:background="@drawable/bg_edit_text"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/text_hint"
        app:layout_constraintTop_toBottomOf="@id/etNewPassword"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btnChangePasswordSubmit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Changes"
        android:textColor="@color/on_primary"
        android:background="@drawable/bg_button_rounded"
        app:layout_constraintTop_toBottomOf="@id/etConfirmPassword"
        android:layout_marginTop="48dp"
        app:backgroundTint="@null"/>

</androidx.constraintlayout.widget.ConstraintLayout>
